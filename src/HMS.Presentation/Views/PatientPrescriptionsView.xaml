<UserControl x:Class="HMS.Core.Views.PatientPrescriptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:HMS.Core.Common.Converters;assembly=HMS.Core.Common"
             Background="Transparent">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="MY PRESCRIPTIONS" FontSize="24" FontWeight="Black" Foreground="#0F172A"/>
            <TextBlock Text="View your current and past medication prescriptions from your doctors." Foreground="#64748B" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content (List) -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="15" Background="White" materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- DataGrid Header (Custom) -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="15,15,0,0" Padding="20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="4*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="DATE" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="DOCTOR" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="MEDICATIONS" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="STATUS" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- DataGrid Content -->
                <ListView Grid.Row="1" ItemsSource="{Binding Prescriptions}" BorderThickness="0" Background="Transparent" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,5"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" Background="White" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,15">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="4*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Date -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PrescriptionDate, StringFormat='{}{0:MMM dd, yyyy}'}" FontWeight="Bold" Foreground="#1E293B" FontSize="14"/>
                                    <TextBlock Text="{Binding PrescriptionDate, StringFormat='{}{0:hh:mm tt}'}" Foreground="#94A3B8" FontSize="12"/>
                                </StackPanel>

                                <!-- Doctor -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="30" Height="30" CornerRadius="15" Background="#EEF2FF" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="Stethoscope" Foreground="#6366F1" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding DoctorName}" FontWeight="SemiBold" Foreground="#334155" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Medications Summary -->
                                <TextBlock Grid.Column="2" Text="{Binding MedicinesSummary}" Foreground="#475569" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,15,0"/>

                                <!-- Status Badge -->
                                <Border Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center" CornerRadius="6" Padding="10,5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FEF3C7"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Dispensed">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#D97706"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Dispensed">
                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
