<UserControl x:Class="HMS.Core.Views.LabTechResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             Background="Transparent" Width="800">

    <Border CornerRadius="16" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="10" Opacity="0.15" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="16,16,0,0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="30,25">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="ENTER TEST RESULTS" FontSize="18" FontWeight="ExtraBold" Foreground="#0F172A" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="{Binding Test.TestName}" FontSize="14" FontWeight="Bold" Foreground="#3B82F6" />
                            <TextBlock Text=" | " FontSize="14" Foreground="#CBD5E1" />
                            <TextBlock Text="{Binding Test.TestCategory}" FontSize="14" Foreground="#64748B" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignIconForegroundButton}" 
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            Foreground="#94A3B8" Width="36" Height="36" Padding="0" VerticalAlignment="Top">
                        <materialDesign:PackIcon Kind="Close" Width="24" Height="24" />
                    </Button>
                </Grid>
            </Border>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Border Padding="40,30">
                    <StackPanel>
                <TextBlock Text="RESULT SUMMARY" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10" />
                <TextBox Text="{Binding ResultSummary, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="e.g. Normal, High, Abnormal, Positive, Negative"
                         Background="#F8FAFC" BorderBrush="#CBD5E1"
                         FontSize="15" Padding="15" Margin="0,0,0,20" />

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="NUMERICAL VALUE" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10" />
                        <TextBox Text="{Binding NumericalValue, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="14" Padding="12" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="UNIT" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10" />
                        <TextBox Text="{Binding Unit, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="14" Padding="12" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="REFERENCE RANGE" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10" />
                        <TextBox Text="{Binding ReferenceRange, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="e.g. 70-110"
                                 Background="#F8FAFC" BorderBrush="#CBD5E1" FontSize="14" Padding="12" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="DETAILED FINDINGS" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10" />
                <TextBox Text="{Binding ResultDetails, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Enter numerical values, observations, and comprehensive result data here..."
                         Background="#F8FAFC" BorderBrush="#CBD5E1"
                         Height="160" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" Padding="15" FontSize="14" Margin="0,0,0,30" />

                <TextBlock Text="TECHNICIAN NOTES (Optional)" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,10" />
                <TextBox Text="{Binding ClinicalNotes, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                         materialDesign:HintAssist.Hint="Any additional remarks regarding the sample quality or testing conditions."
                         Background="#F8FAFC" BorderBrush="#CBD5E1"
                         Height="80" TextWrapping="Wrap" AcceptsReturn="True"
                         VerticalContentAlignment="Top" Padding="15" FontSize="14" Margin="0,0,0,20" />

                <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding IsCriticalValue}" Content="MARK AS CRITICAL VALUE" 
                                  Foreground="#991B1B" FontWeight="Bold" Margin="0,0,0,10" />
                        <TextBox Text="{Binding CriticalValueNote, UpdateSourceTrigger=PropertyChanged}"
                                 Visibility="{Binding IsCriticalValue, Converter={StaticResource BooleanToVisibilityConverter}}"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 materialDesign:HintAssist.Hint="Enter critical value alert details..."
                                 Background="White" BorderBrush="#F87171" FontSize="14" Padding="12" />
                    </StackPanel>
                </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- Footer Actions -->
            <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="0,0,16,16" Padding="30,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="CANCEL" Style="{StaticResource MaterialDesignFlatButton}" 
                            HorizontalAlignment="Left" Foreground="#64748B" FontWeight="Bold"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" />
                    
                    <Button Grid.Column="1" Style="{StaticResource MaterialDesignRaisedButton}"
                            Command="{Binding SaveResultsCommand}" 
                            materialDesign:ButtonAssist.CornerRadius="8"
                            Background="#10B981" BorderThickness="0" Foreground="White"
                            Height="45" Padding="25,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckAll" Margin="0,0,8,0" Width="20" Height="20" VerticalAlignment="Center" />
                            <TextBlock Text="FINALIZE RESULTS" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
