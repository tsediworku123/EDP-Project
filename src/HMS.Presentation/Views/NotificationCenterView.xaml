<UserControl x:Class="HMS.Core.Views.NotificationCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="380" Height="500" Background="Transparent">
    
    <materialDesign:Card UniformCornerRadius="16" Background="White" materialDesign:ElevationAssist.Elevation="Dp6" Margin="5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#F8FAFC" Padding="20,15" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="BellBadgeOutline" Width="20" Height="20" Foreground="#3B82F6" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="NOTIFICATIONS" FontWeight="ExtraBold" FontSize="14" Foreground="#1E293B" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Content="Clear All" Style="{StaticResource MaterialDesignFlatButton}" 
                            FontSize="11" Foreground="#64748B" Padding="8,0" Height="30" />
                </Grid>
            </Border>

            <!-- List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,100,0,0"
                                Visibility="{Binding StatusText, Converter={StaticResource NullToVisibilityConverter}}">
                         <materialDesign:PackIcon Kind="BellOffOutline" Width="48" Height="48" Foreground="#E2E8F0" HorizontalAlignment="Center" />
                         <TextBlock Text="No new notifications" FontSize="14" Foreground="#94A3B8" Margin="0,10,0,0" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Notifications}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource MaterialDesignFlatButton}" Padding="0" HorizontalContentAlignment="Stretch" Height="Auto" Margin="0,0,0,1">
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,15">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" Background="#EFF6FF" Margin="0,0,15,0" VerticalAlignment="Top">
                                                <materialDesign:PackIcon Kind="InformationOutline" Width="22" Height="22" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="13" Foreground="#1E293B" />
                                                <TextBlock Text="{Binding Message}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="18" />
                                                <TextBlock Text="{Binding CreatedAt, StringFormat='{}{0:h:mm tt}'}" FontSize="10" Foreground="#94A3B8" Margin="0,6,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F8FAFC" Padding="15" BorderBrush="#F1F5F9" BorderThickness="0,1,0,0">
                <Button Content="VIEW ALL HISTORY" Style="{StaticResource MaterialDesignFlatMidPrimaryButton}" 
                        Foreground="#3B82F6" FontSize="11" FontWeight="Bold" Width="200" HorizontalAlignment="Center" />
            </Border>
        </Grid>
    </materialDesign:Card>
</UserControl>
