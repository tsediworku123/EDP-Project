<UserControl x:Class="HMS.Core.Views.BookVisitView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:HMS.Core.ViewModels"
             xmlns:utils="clr-namespace:HMS.Core.Utils"
             mc:Ignorable="d" 
             d:DesignHeight="850" d:DesignWidth="1200"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             Background="#F8FAFC">

    <UserControl.Resources>
        <utils:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:BookVisitViewModel />
    </UserControl.DataContext>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="60,40">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 1. TITLE -->
            <StackPanel Grid.Row="0" Margin="0,0,0,35">
                <TextBlock Text="SCHEDULE A NEW VISIT" 
                           Style="{StaticResource MaterialDesignHeadline3TextBlock}" 
                           FontWeight="Bold" Foreground="#2196F3" />
                <TextBlock Text="Find your preferred physician, check availability, and secure a timeslot." 
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}" 
                           Opacity="0.6" Margin="4,12,0,0" />
            </StackPanel>

            <!-- 2. SPECIALTY CHIPS -->
            <StackPanel Grid.Row="1" Margin="0,0,0,40">
                <TextBlock Text="FILTER BY SPECIALTY" Style="{StaticResource MaterialDesignOverlineTextBlock}" 
                           FontWeight="Bold" Foreground="#1E293B" Opacity="0.6" Margin="5,0,0,15" />
                <ListBox ItemsSource="{Binding Specialties}" SelectedItem="{Binding SelectedSpecialty}" 
                         Style="{StaticResource MaterialDesignChoiceChipPrimaryListBox}" Padding="0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Margin" Value="0,0,12,12" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </StackPanel>

            <!-- 3. DOCTOR & SLOT SELECTION -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: PHYSICIAN LIST WITH AVAILABILITY -->
                <StackPanel Grid.Column="0" Margin="0,0,45,0">
                    <TextBlock Text="CHOOSE YOUR PHYSICIAN" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" 
                               FontWeight="Bold" Opacity="0.5" Margin="0,0,0,20" />
                    
                    <materialDesign:Card UniformCornerRadius="15" Padding="0" materialDesign:ElevationAssist.Elevation="Dp2" ClipToBounds="True">
                        <StackPanel>
                            <!-- Search Bar -->
                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Height="55" Padding="20,0">
                                <Grid>
                                    <materialDesign:PackIcon Kind="Magnify" Width="22" Height="22" Opacity="0.4" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                             materialDesign:TextFieldAssist.PrefixText="       " 
                                             materialDesign:HintAssist.Hint="Search Physician..." 
                                             Style="{StaticResource MaterialDesignFloatingHintTextBox}" 
                                             BorderThickness="0" VerticalAlignment="Center" FontSize="14" />
                                </Grid>
                            </Border>
                            
                            <!-- Doctor List with Availability -->
                            <ListBox ItemsSource="{Binding FilteredDoctors}" SelectedItem="{Binding SelectedDoctorInfo}" 
                                     Height="450" Margin="0" BorderThickness="0"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="18,12">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Doctor Icon -->
                                                <Border Width="44" Height="44" CornerRadius="22" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#DBEAFE"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                                    <Setter Property="Background" Value="#FEE2E2"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding WorksOnSelectedDate}" Value="False">
                                                                    <Setter Property="Background" Value="#F1F5F9"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <materialDesign:PackIcon Kind="Doctor" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding WorksOnSelectedDate}" Value="False">
                                                                        <Setter Property="Foreground" Value="#94A3B8"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Border>
                                                
                                                <!-- Doctor Info -->
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="14" Foreground="#1E293B" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                        <TextBlock Text="{Binding Specialty}" Foreground="#64748B" FontSize="12"/>
                                                        <TextBlock Text=" • " Foreground="#CBD5E1" Margin="4,0"/>
                                                        <materialDesign:PackIcon Kind="Clock" Width="12" Height="12" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                        <TextBlock Text="{Binding WorkingHours}" Foreground="#94A3B8" FontSize="11"/>
                                                    </StackPanel>
                                                    <!-- Availability row -->
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Border CornerRadius="3" Padding="6,2">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                                            <Setter Property="Background" Value="#FEE2E2"/>
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding WorksOnSelectedDate}" Value="False">
                                                                            <Setter Property="Background" Value="#F1F5F9"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock Text="{Binding AvailabilityText}" FontSize="11" FontWeight="SemiBold">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#16A34A"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                                                <Setter Property="Foreground" Value="#EF4444"/>
                                                                            </DataTrigger>
                                                                            <DataTrigger Binding="{Binding WorksOnSelectedDate}" Value="False">
                                                                                <Setter Property="Foreground" Value="#94A3B8"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Border>
                                                        <!-- Next available hint -->
                                                        <TextBlock Margin="8,0,0,0" FontSize="10" Foreground="#F59E0B" VerticalAlignment="Center"
                                                                   Text="{Binding NextAvailableDate, StringFormat='Next: {0}'}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </StackPanel>
                                                
                                                <!-- Booked count badge -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock HorizontalAlignment="Center" FontSize="18" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#3B82F6"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsFull}" Value="True">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                        <Run Text="{Binding BookedSlots, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding TotalSlots, Mode=OneWay}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="booked" FontSize="10" Foreground="#94A3B8" HorizontalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Reason Input -->
                    <materialDesign:Card UniformCornerRadius="15" Margin="0,30,0,0" Padding="25" materialDesign:ElevationAssist.Elevation="Dp2">
                        <StackPanel>
                            <TextBlock Text="REASON FOR VISIT" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" 
                                       FontWeight="Bold" Opacity="0.5" Margin="0,0,0,15" />
                            <TextBox Text="{Binding Reason}" Style="{StaticResource MaterialDesignOutlinedTextBox}" 
                                     materialDesign:HintAssist.Hint="Briefly describe your symptoms..." 
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                     Height="90" FontSize="14" />
                        </StackPanel>
                    </materialDesign:Card>
                </StackPanel>

                <!-- RIGHT: CALENDAR & SLOTS -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="PREFERRED DATE &amp; TIME" Style="{StaticResource MaterialDesignSubtitle2TextBlock}" 
                               FontWeight="Bold" Opacity="0.5" Margin="0,0,0,20" />
                    
                    <materialDesign:Card UniformCornerRadius="15" Padding="30" materialDesign:ElevationAssist.Elevation="Dp3">
                        <StackPanel>
                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="12" Padding="15">
                                <Viewbox Height="250">
                                    <Calendar SelectedDate="{Binding SelectedDate}" DisplayDateStart="{Binding SelectedDate}" 
                                              BorderThickness="0" Style="{StaticResource MaterialDesignCalendarPortrait}" />
                                </Viewbox>
                            </Border>

                            <Separator Margin="0,30" Opacity="0.2" />

                            <TextBlock Text="AVAILABLE SESSIONS" Style="{StaticResource MaterialDesignOverlineTextBlock}" 
                                       FontWeight="Bold" Opacity="0.7" HorizontalAlignment="Center" Margin="0,0,0,20" />
                            
                            <ItemsControl ItemsSource="{Binding AvailableSlots}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <RadioButton Style="{StaticResource MaterialDesignChoiceChipRadioButton}" 
                                                     Content="{Binding Time, StringFormat='hh:mm tt'}" 
                                                     Height="48" Margin="6" Padding="0" Cursor="Hand"
                                                     BorderBrush="#2196F3" Foreground="#2196F3"
                                                     IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel Visibility="{Binding AvailableSlots.Count, Converter={StaticResource InverseBoolToVisibilityConverter}, ConverterParameter=0}" 
                                        HorizontalAlignment="Center" Margin="0,15">
                                <materialDesign:PackIcon Kind="InformationOutline" HorizontalAlignment="Center" Opacity="0.4" Width="28" Height="28" />
                                <TextBlock Text="No slots available. Select a different doctor or date." 
                                           HorizontalAlignment="Center" Opacity="0.5" FontStyle="Italic" Margin="0,8,0,0" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- Confirm Button -->
                    <Button Command="{Binding ConfirmCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" 
                            Height="65" VerticalAlignment="Bottom" Margin="0,30,0,0" 
                            Background="#3B82F6" BorderBrush="#3B82F6"
                            materialDesign:ButtonAssist.CornerRadius="32" FontWeight="Bold" FontSize="17" Cursor="Hand">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CalendarCheck" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <TextBlock Text="SECURE APPOINTMENT" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
