<UserControl x:Class="HMS.Core.Views.NurseDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Stats Row -->
        <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,25">
            <!-- Ward Patients -->
            <materialDesign:Card Margin="0,0,15,0" Padding="25" UniformCornerRadius="15">
                <StackPanel>
                    <materialDesign:PackIcon Kind="AccountGroup" Foreground="#3B82F6" Width="32" Height="32"/>
                    <TextBlock Text="{Binding TotalPatientsInWard}" FontSize="32" FontWeight="Bold" Foreground="#1E293B" Margin="0,15,0,0"/>
                    <TextBlock Text="Patients in Ward" Foreground="#64748B" FontWeight="SemiBold"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Pending Vitals -->
            <materialDesign:Card Margin="7,0,7,0" Padding="25" UniformCornerRadius="15">
                <StackPanel>
                    <materialDesign:PackIcon Kind="ClipboardFileOutline" Foreground="#EF4444" Width="32" Height="32"/>
                    <TextBlock Text="{Binding PendingVitalsCount}" FontSize="32" FontWeight="Bold" Foreground="#1E293B" Margin="0,15,0,0"/>
                    <TextBlock Text="Pending Vitals" Foreground="#64748B" FontWeight="SemiBold"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- Medication Rounds -->
            <materialDesign:Card Margin="15,0,0,0" Padding="25" UniformCornerRadius="15">
                <StackPanel>
                    <materialDesign:PackIcon Kind="ViewList" Foreground="#10B981" Width="32" Height="32"/>
                    <TextBlock Text="{Binding MedsToAdministerCount}" FontSize="32" FontWeight="Bold" Foreground="#1E293B" Margin="0,15,0,0"/>
                    <TextBlock Text="Meds Due Today" Foreground="#64748B" FontWeight="SemiBold"/>
                </StackPanel>
            </materialDesign:Card>
        </UniformGrid>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Today's Schedule / Tasks -->
            <materialDesign:Card Grid.Column="0" Margin="0,0,15,0" UniformCornerRadius="15" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="TODAY'S CARE SCHEDULE" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20"/>
                    
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding CareSchedule}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" Padding="15" CornerRadius="10" Margin="0,0,0,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="40" Height="40" Background="#DBEAFE" CornerRadius="20">
                                            <materialDesign:PackIcon Kind="ClipboardFileOutline" Foreground="#3B82F6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="15,0">
                                            <TextBlock Text="{Binding PatientName, StringFormat='Checkup: {0}'}" FontWeight="Bold" Foreground="#1E293B"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#64748B" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="#94A3B8" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </materialDesign:Card>

            <!-- Recent Activity -->
            <materialDesign:Card Grid.Column="1" UniformCornerRadius="15" Padding="25">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="RECENT UPDATES" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,20"/>
                    
                    <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentActivities}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderThickness="0,0,0,1" BorderBrush="#F1F5F9" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,12,0"/>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}" FontSize="13" Foreground="#1E293B" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Time}" FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </materialDesign:Card>
        </Grid>
    </Grid>
</UserControl>
