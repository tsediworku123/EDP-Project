<UserControl x:Class="HMS.Core.Views.PharmacistDispenseDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="850" Height="650" Background="Transparent">
    <materialDesign:Card UniformCornerRadius="15" Background="White" materialDesign:ElevationAssist.Elevation="Dp5">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0" Background="#F8FAFC" CornerRadius="15,15,0,0" Padding="25,20" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="DISPENSE PRESCRIPTION" FontSize="20" FontWeight="Black" Foreground="#0F172A" />
                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Patient: " Foreground="#64748B" FontSize="13"/>
                            <TextBlock Text="{Binding Patient.FullName}" FontWeight="Bold" Foreground="#1E293B" FontSize="13" Margin="0,0,20,0"/>
                            <TextBlock Text="Prescribed By: " Foreground="#64748B" FontSize="13"/>
                            <TextBlock Text="{Binding Doctor.FullName}" FontWeight="Bold" Foreground="#1E293B" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                    <Button HorizontalAlignment="Right" Style="{StaticResource MaterialDesignIconForegroundButton}" 
                            Command="{Binding CancelCommand}" Foreground="#94A3B8" Width="36" Height="36">
                        <materialDesign:PackIcon Kind="Close" Width="24" Height="24" />
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="25">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="300" />
                </Grid.ColumnDefinitions>

                <!-- Items List -->
                <GroupBox Grid.Column="0" Header="MEDICATIONS" Style="{StaticResource MaterialDesignGroupBox}" 
                          materialDesign:ColorZoneAssist.Mode="Standard"
                          BorderBrush="#E2E8F0" Margin="0,0,20,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="0,15">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            
                                            <!-- Medication Info -->
                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding MedicineName}" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                                                    <TextBlock Text="{Binding Dosage}" FontSize="12" Foreground="#64748B"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StockStatus}" FontSize="11" FontWeight="Bold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Instructions -->
                                            <StackPanel Grid.Row="1" Margin="0,10,0,0">
                                                <TextBlock Text="DOCTOR INSTRUCTIONS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                                <TextBlock Text="{Binding DoctorInstructions}" FontSize="12" Foreground="#475569" FontStyle="Italic" Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <!-- Pharmacist Input -->
                                            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                                                <TextBlock Text="PHARMACIST ADVICE / LABEL INSTRUCTIONS" FontSize="10" FontWeight="Bold" Foreground="#94A3B8"/>
                                                <TextBox Text="{Binding PharmacistInstructions, UpdateSourceTrigger=PropertyChanged}" 
                                                         Margin="0,5,0,0" Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                                         FontSize="13" Padding="10,8" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="60"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </GroupBox>

                <!-- Summary & Notes -->
                <StackPanel Grid.Column="1">
                    <materialDesign:Card UniformCornerRadius="10" Background="#F8FAFC" Padding="20" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Text="BILLING SUMMARY" FontWeight="Bold" FontSize="14" Foreground="#475569" Margin="0,0,0,15"/>
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding MedicineName}" FontSize="12" Foreground="#64748B"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TotalPrice, StringFormat='{}{0:C}'}" FontSize="12" FontWeight="Bold" Foreground="#1E293B"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Separator Background="#E2E8F0" Margin="0,10"/>
                            <Grid>
                                <TextBlock Text="GRAND TOTAL" FontWeight="Bold" FontSize="16" Foreground="#1E293B"/>
                                <TextBlock Text="{Binding GrandTotal, StringFormat='{}{0:C}'}" FontWeight="Black" FontSize="18" Foreground="#8B5CF6" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </materialDesign:Card>

                    <TextBlock Text="DISPENSING NOTES" FontSize="12" FontWeight="Bold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding DispensingNotes, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="150" 
                             materialDesign:HintAssist.Hint="Internal notes about this dispensing session..."
                             FontSize="13" Padding="12" VerticalAlignment="Top"/>
                </StackPanel>
            </Grid>

            <!-- Footer -->
            <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="0,0,15,15" Padding="25,15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL" Command="{Binding CancelCommand}" 
                            Style="{StaticResource MaterialDesignFlatButton}" Foreground="#64748B" Margin="0,0,10,0"/>
                    <Button Content="FINALIZE DISPENSING" Command="{Binding DispenseCommand}" 
                            Style="{StaticResource MaterialDesignRaisedButton}" Background="#10B981" BorderThickness="0"
                            Padding="30,0" Height="45"/>
                </StackPanel>
            </Border>
        </Grid>
    </materialDesign:Card>
</UserControl>
