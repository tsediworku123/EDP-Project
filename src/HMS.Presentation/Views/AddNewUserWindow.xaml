<Window x:Class="HMS.Core.Views.AddNewUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Add New User" Height="550" Width="450"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid Margin="24">
        <StackPanel>
            <TextBlock Text="Add New User" Style="{StaticResource MaterialDesignHeadline4TextBlock}" Margin="0,0,0,24"/>

            <ComboBox materialDesign:HintAssist.Hint="Role *" 
                      ItemsSource="{Binding Roles}"
                      SelectedItem="{Binding SelectedRole}"
                      Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,8"/>

            <materialDesign:TransitioningContent OpeningEffect="{materialDesign:TransitionEffect FadeIn}">
                <StackPanel>
                    <ComboBox materialDesign:HintAssist.Hint="Link to Doctor *" 
                              ItemsSource="{Binding Doctors}"
                              SelectedItem="{Binding SelectedDoctor}"
                              DisplayMemberPath="FullName"
                              Visibility="{Binding IsDoctorRoleSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,8"/>

                    <ComboBox materialDesign:HintAssist.Hint="Link to Patient *" 
                              ItemsSource="{Binding Patients}"
                              SelectedItem="{Binding SelectedPatient}"
                              DisplayMemberPath="FullName"
                              Visibility="{Binding IsPatientRoleSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,8"/>

                    <ComboBox materialDesign:HintAssist.Hint="Link to Nurse *" 
                              ItemsSource="{Binding Nurses}"
                              SelectedItem="{Binding SelectedNurse}"
                              DisplayMemberPath="FullName"
                              Visibility="{Binding IsNurseRoleSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,8"/>

                    <ComboBox materialDesign:HintAssist.Hint="Link to Pharmacist *" 
                              ItemsSource="{Binding Pharmacists}"
                              SelectedItem="{Binding SelectedPharmacist}"
                              DisplayMemberPath="FullName"
                              Visibility="{Binding IsPharmacistRoleSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,8"/>

                    <ComboBox materialDesign:HintAssist.Hint="Link to Lab Technician *" 
                              ItemsSource="{Binding LabTechs}"
                              SelectedItem="{Binding SelectedLabTech}"
                              DisplayMemberPath="FullName"
                              Visibility="{Binding IsLabTechRoleSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,8"/>

                    <ComboBox materialDesign:HintAssist.Hint="Link to Receptionist/Billing Staff *" 
                              ItemsSource="{Binding BillingStaffs}"
                              SelectedItem="{Binding SelectedBillingStaff}"
                              DisplayMemberPath="FullName"
                              Visibility="{Binding IsReceptionistRoleSelected, Converter={StaticResource BooleanToVisibilityConverter}}"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,8"/>
                </StackPanel>
            </materialDesign:TransitioningContent>

            <TextBox materialDesign:HintAssist.Hint="Email *" 
                     Text="{Binding Email}" 
                     Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,8"/>

            <PasswordBox materialDesign:HintAssist.Hint="Password *" 
                         x:Name="PassBox"
                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,8"/>

            <PasswordBox materialDesign:HintAssist.Hint="Confirm Password *" 
                         x:Name="ConfirmPassBox"
                         Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,8"/>



            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,32,0,0">
                <Button Style="{StaticResource MaterialDesignFlatButton}" Content="CANCEL" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                <Button Style="{StaticResource MaterialDesignRaisedButton}" Content="CREATE USER" Click="SaveButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
