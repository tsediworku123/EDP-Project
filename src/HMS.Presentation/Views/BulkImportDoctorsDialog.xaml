<UserControl x:Class="HMS.Core.Views.BulkImportDoctorsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="750" MaxHeight="650">
    <Border Background="White" CornerRadius="15" Padding="30">
        <StackPanel>
            <TextBlock Text="BULK IMPORT DOCTORS" FontSize="20" FontWeight="ExtraBold" Foreground="#1E293B"/>
            <TextBlock Text="Add multiple doctors at once. Fill the table or import from CSV." FontSize="12" Foreground="#64748B" Margin="0,4,0,20"/>

            <Border Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Import from CSV" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="Format: FullName, Specialization, Department, Phone, Email" FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BrowseCsvBtn" Content="BROWSE CSV"
                            Style="{DynamicResource MaterialDesignOutlinedButton}" Foreground="#3B82F6" BorderBrush="#3B82F6"
                            Height="36" Margin="0,0,10,0" Click="BrowseCsvBtn_Click"/>
                    <Button Grid.Column="2" x:Name="ImportCsvBtn" Content="IMPORT"
                            Style="{DynamicResource MaterialDesignFlatMidPrimaryButton}" Background="#3B82F6" Foreground="White" BorderThickness="0"
                            Height="36" IsEnabled="False" Click="ImportCsvBtn_Click"/>
                </Grid>
            </Border>

            <TextBlock Text="OR enter manually:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <DataGrid x:Name="BulkGrid" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True"
                          MinHeight="200" MaxHeight="260" BorderThickness="0" GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="White">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Height" Value="38"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#475569"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Full Name *" Binding="{Binding FullName}" Width="160"/>
                        <DataGridTextColumn Header="Specialization" Binding="{Binding Specialization}" Width="130"/>
                        <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="120"/>
                        <DataGridTextColumn Header="Phone" Binding="{Binding Phone}" Width="110"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock x:Name="StatusText" Foreground="#3B82F6" FontSize="12" Margin="0,8,0,15" Visibility="Collapsed"/>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="CANCEL" Style="{DynamicResource MaterialDesignOutlinedButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" CommandParameter="False"
                        Height="42" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="SAVE ALL DOCTORS"
                        Style="{DynamicResource MaterialDesignFlatMidPrimaryButton}" Background="#3B82F6" Foreground="White" BorderThickness="0"
                        Height="42" Margin="8,0,0,0" Click="SaveAllBtn_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
