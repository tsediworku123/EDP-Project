<UserControl x:Class="HMS.Core.Views.PharmacistPrescriptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F1F5F9">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="PRESCRIPTIONS" Style="{DynamicResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" Foreground="#1E293B" />
                <TextBlock Text="Doctor-issued prescriptions — check drug availability and dispense to patients." Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" Opacity="0.6" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="REFRESH" Command="{Binding RefreshCommand}" Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="0,0,10,0" Foreground="#8B5CF6" BorderBrush="#CBD5E1"/>
            </StackPanel>
        </Grid>

        <!-- Legend + Search -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="380"/>
            </Grid.ColumnDefinitions>

            <!-- Availability legend -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="10" Height="10" CornerRadius="5" Background="#10B981" Margin="0,0,5,0"/>
                <TextBlock Text="All drugs available" Foreground="#475569" FontSize="12" Margin="0,0,15,0"/>
                <Border Width="10" Height="10" CornerRadius="5" Background="#F59E0B" Margin="0,0,5,0"/>
                <TextBlock Text="Partially available" Foreground="#475569" FontSize="12" Margin="0,0,15,0"/>
                <Border Width="10" Height="10" CornerRadius="5" Background="#EF4444" Margin="0,0,5,0"/>
                <TextBlock Text="Out of stock" Foreground="#475569" FontSize="12"/>
            </StackPanel>

            <Border Grid.Column="1" Background="White" CornerRadius="20" Padding="15,0" materialDesign:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Search" VerticalAlignment="Center" Foreground="#94A3B8" Width="18" Height="18"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                             BorderThickness="0" VerticalAlignment="Center" Margin="10,0,0,0"
                             materialDesign:HintAssist.Hint="Search by patient or doctor..." />
                </Grid>
            </Border>
        </Grid>

        <!-- Prescriptions Table -->
        <materialDesign:Card Grid.Row="2" UniformCornerRadius="15" materialDesign:ElevationAssist.Elevation="Dp1">
            <DataGrid ItemsSource="{Binding Prescriptions}" AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single" Background="Transparent"
                      BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="None">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Height" Value="50"/>
                        <Setter Property="Padding" Value="15,0"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#475569"/>
                    </Style>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Setter Property="Height" Value="65"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Patient -->
                    <DataGridTemplateColumn Header="PATIENT" Width="1.8*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="34" Height="34" CornerRadius="17" Background="#EDE9FE" Margin="0,0,10,0">
                                        <materialDesign:PackIcon Kind="Account" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" Foreground="#1E293B" FontSize="13"/>
                                        <TextBlock Text="{Binding CardNo}" FontSize="11" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Doctor -->
                    <DataGridTextColumn Header="PRESCRIBED BY" Binding="{Binding DoctorName}" Width="1.4*"/>
                    <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="110"/>
                    
                    <DataGridTemplateColumn Header="MEDICINES" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding MedicinesSummary}" VerticalAlignment="Center" 
                                           TextTrimming="CharacterEllipsis" Foreground="#64748B" FontSize="12"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="ITEMS" Binding="{Binding ItemsCount}" Width="65"/>

                    <!-- Drug Availability -->
                    <DataGridTemplateColumn Header="DRUG AVAILABILITY" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="10" Height="10" CornerRadius="5" Margin="0,0,6,0" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#10B981"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AvailabilityStatus}" Value="OutOfStock">
                                                        <Setter Property="Background" Value="#EF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AvailabilityStatus}" Value="Partial">
                                                        <Setter Property="Background" Value="#F59E0B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <TextBlock Text="{Binding AvailabilityLabel}" VerticalAlignment="Center" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#10B981"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding AvailabilityStatus}" Value="OutOfStock">
                                                        <Setter Property="Foreground" Value="#EF4444"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding AvailabilityStatus}" Value="Partial">
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status badge -->
                    <DataGridTemplateColumn Header="STATUS" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8,4" HorizontalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#F59E0B"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Dispensed">
                                                    <Setter Property="Background" Value="#10B981"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                    <Setter Property="Background" Value="#EF4444"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Status}" Foreground="White" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="ACTIONS" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.ViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource MaterialDesignFlatButton}" Foreground="#3B82F6"
                                            Content="VIEW" Padding="8,4"/>
                                    <Button Command="{Binding DataContext.DispenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource MaterialDesignFlatButton}" Foreground="#10B981"
                                            Content="DISPENSE" Padding="8,4"
                                            Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Button Command="{Binding DataContext.PrintExternalCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{DynamicResource MaterialDesignFlatButton}" Foreground="#F59E0B"
                                            Content="PRINT" Padding="8,4"
                                            Visibility="{Binding IsPending, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
