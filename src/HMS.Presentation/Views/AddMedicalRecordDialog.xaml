<UserControl x:Class="HMS.Core.Views.AddMedicalRecordDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="550" Padding="0">
    <Border Background="White" CornerRadius="15" Padding="35,30">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="700">
            <StackPanel>
                <TextBlock Text="{Binding FormHeader}" 
                           Style="{DynamicResource MaterialDesignHeadline6TextBlock}" 
                           FontWeight="Bold" Margin="0,0,0,25" HorizontalAlignment="Center" Foreground="#1E293B"/>

                <!-- Patient Selection -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Patient *" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <ComboBox ItemsSource="{Binding Patients}"
                              SelectedItem="{Binding SelectedPatient}"
                              Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="Select patient" Padding="15">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullName}" FontWeight="SemiBold"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Title & Date -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Title *" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{DynamicResource MaterialDesignOutlinedTextBox}" Padding="12"
                                 materialDesign:HintAssist.Hint="e.g. Regular Checkup"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Date *" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                        <DatePicker SelectedDate="{Binding Date}" 
                                    Style="{DynamicResource MaterialDesignOutlinedDatePicker}" Padding="12"/>
                    </StackPanel>
                </Grid>

                <!-- Diagnosis -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Diagnosis *" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding Diagnosis, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}" Padding="12"
                             materialDesign:HintAssist.Hint="e.g. Hypertension"/>
                </StackPanel>

                <!-- Treatment & Prescription -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Treatment" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Treatment, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{DynamicResource MaterialDesignOutlinedTextBox}" Height="80" 
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="12"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="Prescription" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding Prescription, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{DynamicResource MaterialDesignOutlinedTextBox}" Height="80" 
                                 TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="12"/>
                    </StackPanel>
                </Grid>

                <!-- Test Results -->
                <StackPanel Margin="0,0,0,20">
                    <TextBlock Text="Test Results" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding TestResults, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}" Padding="12"/>
                </StackPanel>

                <!-- Clinical Notes -->
                <StackPanel Margin="0,0,0,30">
                    <TextBlock Text="Clinical Notes" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding ClinicalNotes, UpdateSourceTrigger=PropertyChanged}" 
                             Style="{DynamicResource MaterialDesignOutlinedTextBox}" Height="100" 
                             TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top" Padding="12"/>
                </StackPanel>

                <!-- Footer Buttons -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCEL" Command="{Binding CancelCommand}" 
                            Style="{DynamicResource MaterialDesignFlatButton}" Margin="0,0,15,0" Foreground="#64748B"/>
                    <Button Content="SAVE RECORD" Command="{Binding SaveCommand}" 
                            Style="{DynamicResource MaterialDesignFlatMidPrimaryButton}" 
                            Background="#10B981" BorderBrush="#10B981" Width="180" Height="42"
                            materialDesign:ButtonAssist.CornerRadius="8"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
