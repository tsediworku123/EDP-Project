<UserControl x:Class="HMS.Core.Views.PatientBillingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="MY BILLS &amp; PAYMENTS" FontSize="24" FontWeight="Black" Foreground="#0F172A"/>
            <TextBlock Text="Review your invoices and track payment history." Foreground="#64748B" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="15" Background="White" materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- DataGrid Header -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="15,15,0,0" Padding="20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="BILL ID" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="DATE &amp; NOTES" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="TOTAL AMOUNT" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="STATUS" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- DataGrid Content -->
                <ListView Grid.Row="1" ItemsSource="{Binding Bills}" BorderThickness="0" Background="Transparent" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,5"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" Background="White" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,15">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Bill ID -->
                                <TextBlock Grid.Column="0" Text="{Binding Id, StringFormat='INV-{0:0000}'}" FontWeight="Bold" Foreground="#1E293B" FontSize="14" VerticalAlignment="Center"/>

                                <!-- Date & Notes -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding BillDate, StringFormat='{}{0:MMM dd, yyyy}'}" FontWeight="SemiBold" Foreground="#334155" FontSize="13"/>
                                    <TextBlock Text="{Binding FinancialNotes}" Foreground="#64748B" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Amount -->
                                <TextBlock Grid.Column="2" Text="{Binding TotalAmount, StringFormat='{}{0:C}'}" FontWeight="Black" Foreground="#0F172A" FontSize="15" VerticalAlignment="Center"/>

                                <!-- Status Badge & Action -->
                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border HorizontalAlignment="Left" CornerRadius="6" Padding="10,5">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FEE2E2"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Paid">
                                                        <Setter Property="Background" Value="#DCFCE7"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Partially Paid">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Status}" FontWeight="Bold" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#EF4444"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Paid">
                                                            <Setter Property="Foreground" Value="#16A34A"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Partially Paid">
                                                            <Setter Property="Foreground" Value="#D97706"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <!-- Pay Button -->
                                    <Button Command="{Binding DataContext.PayBillCommand, RelativeSource={RelativeSource AncestorType={x:Type ListView}}}"
                                            CommandParameter="{Binding}"
                                            Padding="10,0" Height="28" Margin="10,0,0,0"
                                            Content="PAY NOW" FontSize="11" FontWeight="Bold" Foreground="#3B82F6">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignFlatButton}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Paid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
