<UserControl x:Class="HMS.Core.Views.GenerateBillDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="500" MaxHeight="600">
    <Border Background="White" CornerRadius="15" Padding="30">
        <StackPanel>
            <TextBlock Text="GENERATE NEW BILL" FontSize="20" FontWeight="ExtraBold" Foreground="#1E293B" Margin="0,0,0,25"/>

            <TextBox Text="{Binding PatientName, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Patient Name"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,15"/>

            <TextBox Text="{Binding TotalAmount, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Total Amount ($)"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,15"/>

            <ComboBox Text="{Binding Status}"
                      materialDesign:HintAssist.Hint="Status"
                      Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                      Margin="0,0,0,25">
                <ComboBoxItem Content="Paid"/>
                <ComboBoxItem Content="Unpaid"/>
            </ComboBox>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="CANCEL" 
                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="False"
                        Height="40" Margin="0,0,8,0"/>

                <Button Grid.Column="1" Content="GENERATE"
                        Style="{DynamicResource MaterialDesignFlatMidPrimaryButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="True"
                        Background="#8B5CF6" Foreground="White" BorderThickness="0"
                        Height="40" Margin="8,0,0,0"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
