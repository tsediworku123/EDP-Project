<UserControl x:Class="HMS.Core.Views.PatientLabResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="MY LAB RESULTS" FontSize="24" FontWeight="Black" Foreground="#0F172A"/>
            <TextBlock Text="View your diagnostic test results and clinical notes." Foreground="#64748B" FontSize="14" Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Main Content -->
        <materialDesign:Card Grid.Row="1" UniformCornerRadius="15" Background="White" materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- DataGrid Header -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="15,15,0,0" Padding="20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="3*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="TEST NAME" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Grid.Column="1" Text="ORDERED BY" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Grid.Column="2" Text="RESULTS &amp; NOTES" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                        <TextBlock Grid.Column="3" Text="DATE" FontWeight="Bold" Foreground="#64748B" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- DataGrid Content -->
                <ListView Grid.Row="1" ItemsSource="{Binding TestResults}" BorderThickness="0" Background="Transparent" Margin="0,10,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,5"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd" Background="White" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="20,15">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="3*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Test Name -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                    <TextBlock Text="{Binding TestName}" FontWeight="Bold" Foreground="#1E293B" FontSize="15" TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Doctor -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="#F3F4F6" Margin="0,0,8,0">
                                        <materialDesign:PackIcon Kind="Doctor" Foreground="#475569" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding DoctorName}" FontWeight="SemiBold" Foreground="#475569" FontSize="13" VerticalAlignment="Center"/>
                                </StackPanel>

                                <!-- Results -->
                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,15,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Result: " FontWeight="SemiBold" Foreground="#64748B" FontSize="13"/>
                                        <TextBlock Text="{Binding ResultValue}" FontWeight="Black" Foreground="#0F172A" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Reference: " Foreground="#94A3B8" FontSize="11"/>
                                        <TextBlock Text="{Binding ReferenceRange}" Foreground="#64748B" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Notes}" Foreground="#475569" FontSize="12" FontStyle="Italic" Margin="0,4,0,0" TextWrapping="Wrap" MaxHeight="40"/>
                                </StackPanel>

                                <!-- Date -->
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CompletionDate, StringFormat='{}{0:MMM dd, yyyy}'}" FontWeight="SemiBold" Foreground="#334155" FontSize="13"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </materialDesign:Card>
    </Grid>
</UserControl>
