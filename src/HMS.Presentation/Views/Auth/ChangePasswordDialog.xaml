<UserControl x:Class="HMS.Core.Views.Auth.ChangePasswordDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="350" Padding="20">
    <StackPanel>
        <TextBlock Text="Change Password" Style="{StaticResource MaterialDesignHeadline5TextBlock}" Margin="0,0,0,20"/>
        
        <PasswordBox x:Name="OldPasswordBox" materialDesign:HintAssist.Hint="Current Password" 
                     Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,10"/>
        
        <PasswordBox x:Name="NewPasswordBox" materialDesign:HintAssist.Hint="New Password" 
                     Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,10"/>
        
        <PasswordBox x:Name="ConfirmPasswordBox" materialDesign:HintAssist.Hint="Confirm New Password" 
                     Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,10"/>
        
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="CANCEL" Command="{Binding CancelCommand}" 
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
            <Button Content="CHANGE PASSWORD" Click="Change_Click" 
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
