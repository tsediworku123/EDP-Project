<Window x:Class="HMS.Core.Views.Auth.RegisterView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Register New Account" Height="720" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Border CornerRadius="16" Background="#0F172A" Effect="{DynamicResource MaterialDesignShadowDepth5}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Title Bar -->
            <Grid Grid.Row="0" Height="60" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Background="Transparent">
                <Button HorizontalAlignment="Left" VerticalAlignment="Center" Margin="15,0,0,0" 
                        Style="{StaticResource MaterialDesignIconButton}" Foreground="#94A3B8" Click="BackToLogin_Click" ToolTip="Back to Login">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="20" Height="20"/>
                </Button>
                
                <Button HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,15,0" Width="32" Height="32"
                        Style="{StaticResource MaterialDesignIconButton}" Foreground="#94A3B8" Click="CloseButton_Click" ToolTip="Close Application">
                    <materialDesign:PackIcon Kind="Close" Width="18" Height="18"/>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="40,10,40,40">
                    <TextBlock Text="Create Account" FontSize="28" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center"/>
                    <TextBlock Text="Join MediCare HMS as a new Patient" FontSize="13" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,8,0,35"/>

                    <TextBlock Text="FULL NAME" FontSize="11" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,8"/>
                    <Border CornerRadius="10" Background="#1E293B" Margin="0,0,0,20" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Account" Foreground="#64748B" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="NameBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" FontSize="15" VerticalAlignment="Center" Padding="0,0,15,0" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="EMAIL ADDRESS" FontSize="11" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,8"/>
                    <Border CornerRadius="10" Background="#1E293B" Margin="0,0,0,20" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Email" Foreground="#64748B" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="EmailBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" FontSize="15" VerticalAlignment="Center" Padding="0,0,15,0" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                        </Grid>
                    </Border>
                    
                    <TextBlock Text="PHONE NUMBER" FontSize="11" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,8"/>
                    <Border CornerRadius="10" Background="#1E293B" Margin="0,0,0,20" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Phone" Foreground="#64748B" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" x:Name="PhoneBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" FontSize="15" VerticalAlignment="Center" Padding="0,0,15,0" materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,8"/>
                    <Border CornerRadius="10" Background="#1E293B" Margin="0,0,0,20" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Lock" Foreground="#64748B" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <PasswordBox Grid.Column="1" x:Name="PasswordBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" FontSize="15" VerticalAlignment="Center" Padding="0,0,15,0"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="CONFIRM PASSWORD" FontSize="11" FontWeight="Bold" Foreground="#3B82F6" Margin="0,0,0,8"/>
                    <Border CornerRadius="10" Background="#1E293B" Margin="0,0,0,35" Height="50">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="LockCheck" Foreground="#64748B" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <PasswordBox Grid.Column="1" x:Name="ConfirmPasswordBox" Background="Transparent" BorderThickness="0" Foreground="White" CaretBrush="White" FontSize="15" VerticalAlignment="Center" Padding="0,0,15,0"/>
                        </Grid>
                    </Border>

                    <Button Height="55" Click="RegisterButton_Click" Cursor="Hand" Background="#3B82F6" Foreground="White" materialDesign:ButtonAssist.CornerRadius="12" BorderThickness="0" materialDesign:ElevationAssist.Elevation="Dp4">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountPlus" Width="22" Height="22" VerticalAlignment="Center"/>
                            <TextBlock Text="Register Now" Margin="12,0,0,0" VerticalAlignment="Center" FontWeight="Bold" FontSize="16"/>
                        </StackPanel>
                    </Button>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,30,0,0">
                        <TextBlock Text="Already have an account?" Foreground="#64748B" VerticalAlignment="Center" FontSize="14"/>
                        <Button Content="Sign In" Style="{StaticResource MaterialDesignFlatButton}" Foreground="#3B82F6" FontWeight="Bold" FontSize="14" Height="35" Click="BackToLogin_Click" Cursor="Hand" Margin="5,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
