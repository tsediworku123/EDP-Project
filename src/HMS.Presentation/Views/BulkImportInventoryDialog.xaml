<UserControl x:Class="HMS.Core.Views.BulkImportInventoryDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="720" MaxHeight="700">
    <Border Background="White" CornerRadius="15" Padding="30">
        <StackPanel>
            <!-- Header -->
            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="BULK IMPORT DRUGS" FontSize="20" FontWeight="ExtraBold" Foreground="#1E293B"/>
                <TextBlock Text="Add multiple drugs at once. Fill in the table or import from a CSV file." 
                           FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- CSV Import row -->
            <Border Background="#F8FAFC" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Import from CSV file" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <TextBlock Text="Format: Name, SKU, Category, UnitType, Qty, Price, ExpiryDate" 
                                   FontSize="11" Foreground="#94A3B8"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="BrowseCsvBtn" Content="BROWSE CSV"
                            Style="{DynamicResource MaterialDesignOutlinedButton}"
                            Foreground="#8B5CF6" BorderBrush="#8B5CF6"
                            Height="36" Margin="0,0,10,0"
                            Click="BrowseCsvBtn_Click"/>
                    <Button Grid.Column="2" x:Name="ImportCsvBtn" Content="IMPORT"
                            Style="{DynamicResource MaterialDesignFlatMidPrimaryButton}"
                            Background="#8B5CF6" Foreground="White" BorderThickness="0"
                            Height="36" IsEnabled="False"
                            Click="ImportCsvBtn_Click"/>
                </Grid>
            </Border>

            <!-- Manual table -->
            <TextBlock Text="OR enter manually:" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,8"/>
            
            <Border BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8">
                <DataGrid x:Name="BulkGrid"
                          AutoGenerateColumns="False"
                          CanUserAddRows="True"
                          CanUserDeleteRows="True"
                          MinHeight="220" MaxHeight="280"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          Background="White">
                    <DataGrid.Resources>
                        <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Height" Value="40"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="Foreground" Value="#475569"/>
                            <Setter Property="Padding" Value="8,0"/>
                        </Style>
                    </DataGrid.Resources>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name *" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="160"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding SKU, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="Category" Binding="{Binding Category, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <DataGridTextColumn Header="Unit Type" Binding="{Binding UnitType, UpdateSourceTrigger=PropertyChanged}" Width="90"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}" Width="60"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding SellingUnitPrice, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                        <DataGridTextColumn Header="Expiry (yyyy-mm-dd)" Binding="{Binding ExpiryDateStr, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <TextBlock Text="* Name is required. Leave SKU blank to auto-generate." 
                       FontSize="11" Foreground="#94A3B8" Margin="0,6,0,20"/>

            <!-- Status -->
            <TextBlock x:Name="StatusText" Foreground="#8B5CF6" FontSize="12" Margin="0,0,0,15" 
                       Visibility="Collapsed"/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="CANCEL"
                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="False"
                        Height="42" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="SAVE ALL"
                        Style="{DynamicResource MaterialDesignFlatMidPrimaryButton}"
                        Background="#8B5CF6" Foreground="White" BorderThickness="0"
                        Height="42" Margin="8,0,0,0"
                        Click="SaveAllBtn_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
