<UserControl x:Class="HMS.Core.Views.AddStaffDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="500">
    <Border Background="White" CornerRadius="12">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="ADD NEW STAFF" Style="{DynamicResource MaterialDesignHeadline6TextBlock}" FontWeight="Bold" Margin="0,0,0,20"/>

            <ScrollViewer Grid.Row="1" MaxHeight="550" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <ComboBox materialDesign:HintAssist.Hint="Staff Role *" 
                              ItemsSource="{Binding Roles}" 
                              SelectedItem="{Binding SelectedRole}"
                              Style="{StaticResource MaterialDesignFloatingHintComboBox}" Margin="0,0,0,15"/>

                    <TextBox materialDesign:HintAssist.Hint="Full Name *" Text="{Binding FullName}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                    <TextBox materialDesign:HintAssist.Hint="Email Address *" Text="{Binding Email}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                    <TextBox materialDesign:HintAssist.Hint="Phone Number" Text="{Binding Phone}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                    <PasswordBox x:Name="PassBox" materialDesign:HintAssist.Hint="Initial Password (Optional)" Style="{StaticResource MaterialDesignFloatingHintPasswordBox}" Margin="0,0,0,15"/>

                    <!-- Role Specific Content -->
                    
                    <!-- Doctor / Nurse / LabTech Fields -->
                    <StackPanel Visibility="{Binding IsDoctorFieldsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox materialDesign:HintAssist.Hint="Specialization *" Text="{Binding Specialization}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                        <TextBox materialDesign:HintAssist.Hint="Department" Text="{Binding Department}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsNurseFieldsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox materialDesign:HintAssist.Hint="Specialization (Triage, ICU, etc.)" Text="{Binding Specialization}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                        <TextBox materialDesign:HintAssist.Hint="Department" Text="{Binding Department}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsPharmacistFieldsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox materialDesign:HintAssist.Hint="License Number *" Text="{Binding LicenseNumber}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsLabTechFieldsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox materialDesign:HintAssist.Hint="Employee Code *" Text="{Binding EmployeeCode}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                        <TextBox materialDesign:HintAssist.Hint="Specialization" Text="{Binding Specialization}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                    </StackPanel>

                    <StackPanel Visibility="{Binding IsBillingStaffFieldsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBox materialDesign:HintAssist.Hint="Employee Code *" Text="{Binding EmployeeCode}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                        <TextBox materialDesign:HintAssist.Hint="Position (Senior Accountant, etc.)" Text="{Binding Position}" Style="{StaticResource MaterialDesignFloatingHintTextBox}" Margin="0,0,0,15"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="CANCEL" Command="{Binding CancelCommand}" Style="{DynamicResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
                <Button Content="SAVE STAFF" Click="SaveButton_Click" Style="{DynamicResource MaterialDesignFlatMidPrimaryButton}" Width="120"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
