<UserControl x:Class="HMS.Core.Views.PharmacistInventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F1F5F9">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,30">
            <StackPanel>
                <TextBlock Text="DRUG INVENTORY" Style="{DynamicResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" Foreground="#1E293B" />
                <TextBlock Text="Manage medicines, monitor stock levels, and track expiry dates." Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" Opacity="0.6" />
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="REFRESH" Command="{Binding RefreshCommand}" Style="{DynamicResource MaterialDesignOutlinedButton}" Margin="0,0,10,0" Foreground="#8B5CF6" BorderBrush="#CBD5E1"/>
                <Button Command="{Binding AddItemCommand}" Style="{DynamicResource MaterialDesignFlatMidPrimaryButton}" Background="#8B5CF6" BorderThickness="0" Padding="20,7">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Text="ADD NEW ITEM" FontWeight="Bold" VerticalAlignment="Center" Foreground="White"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Search -->
        <Grid Grid.Row="1" Margin="0,0,0,25">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="400" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="1" Background="White" CornerRadius="20" Padding="15,0" materialDesign:ElevationAssist.Elevation="Dp1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Search" VerticalAlignment="Center" Foreground="#94A3B8" Width="18" Height="18"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed" 
                             BorderThickness="0" VerticalAlignment="Center" Margin="10,0,0,0" 
                             materialDesign:HintAssist.Hint="Search by medicine name or SKU..." />
                </Grid>
            </Border>
        </Grid>

        <!-- Inventory Table -->
        <materialDesign:Card Grid.Row="2" UniformCornerRadius="15" materialDesign:ElevationAssist.Elevation="Dp1">
            <DataGrid ItemsSource="{Binding Inventory}" AutoGenerateColumns="False" IsReadOnly="True" 
                      CanUserAddRows="False" SelectionMode="Single" Background="Transparent" 
                      BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="None">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Height" Value="50"/>
                        <Setter Property="Padding" Value="15,0"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#475569"/>
                    </Style>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Setter Property="Height" Value="60"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="MEDICINE NAME" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="32" Height="32" CornerRadius="16" Background="#EDE9FE" Margin="0,0,12,0">
                                        <materialDesign:PackIcon Kind="ViewList" Foreground="#8B5CF6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#1E293B"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="120"/>
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" Width="150"/>
                    <DataGridTextColumn Header="PRICE" Binding="{Binding SellingUnitPrice, StringFormat='C'}" Width="100"/>
                    <DataGridTextColumn Header="EXPIRY DATE" Binding="{Binding ExpiryDate, StringFormat='MMM dd, yyyy'}" Width="120"/>
                    
                    <DataGridTemplateColumn Header="STOCK QTY" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#F1F5F9" CornerRadius="4" Padding="8,4" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding StockQuantity}" Foreground="#1E293B" FontWeight="Bold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
