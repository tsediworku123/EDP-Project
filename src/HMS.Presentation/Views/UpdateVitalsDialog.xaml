<UserControl x:Class="HMS.Core.Views.UpdateVitalsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="450" MaxHeight="550">
    <Border Background="White" CornerRadius="15" Padding="30">
        <StackPanel>
            <!-- Header -->
            <StackPanel Margin="0,0,0,25">
                <TextBlock Text="UPDATE VITALS" FontSize="20" FontWeight="ExtraBold" Foreground="#1E293B"/>
                <TextBlock Text="{Binding PatientName}" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding RoomNumber}" FontSize="12" Foreground="#94A3B8"/>
            </StackPanel>

            <!-- Blood Pressure -->
            <TextBlock Text="BLOOD PRESSURE" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
            <TextBox x:Name="BPInput" Text="{Binding BP, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="e.g. 120/80"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,15" FontSize="14"/>

            <!-- Temperature -->
            <TextBlock Text="TEMPERATURE" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="e.g. 36.8°C"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,15" FontSize="14"/>

            <!-- Pulse -->
            <TextBlock Text="PULSE RATE" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Pulse, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="e.g. 72 bpm"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,15" FontSize="14"/>

            <!-- SPO2 -->
            <TextBlock Text="OXYGEN SATURATION (SPO2)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
            <TextBox Text="{Binding SPO2, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="e.g. 98%"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,25" FontSize="14"/>

            <!-- Action Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="CANCEL" 
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="False"
                        Foreground="#64748B" BorderBrush="#CBD5E1"
                        Height="40" Margin="0,0,8,0"/>

                <Button Grid.Column="1" Content="SAVE VITALS"
                        Style="{StaticResource MaterialDesignFlatButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="True"
                        Background="#3B82F6" Foreground="White"
                        Height="40" Margin="8,0,0,0"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
