<UserControl x:Class="HMS.Core.Views.UpdateVitalsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="450" MaxHeight="550">
    
    <UserControl.Resources>
        <!-- Consistent action button style matching Nurse portal -->
        <Style x:Key="DialogActionButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Consistent outlined button style -->
        <Style x:Key="DialogOutlinedButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White" CornerRadius="15" Padding="30">
        <StackPanel>
            <!-- Header -->
            <StackPanel Margin="0,0,0,25">
                <TextBlock Text="UPDATE VITALS" FontSize="20" FontWeight="ExtraBold" Foreground="#1E293B"/>
                <TextBlock Text="{Binding PatientName}" FontSize="14" Foreground="#64748B" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding RoomNumber}" FontSize="12" Foreground="#94A3B8"/>
            </StackPanel>

            <!-- Blood Pressure -->
            <TextBlock Text="BLOOD PRESSURE" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
            <TextBox x:Name="BPInput" Text="{Binding BP, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="e.g. 120/80"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,15" FontSize="14"/>

            <!-- Temperature -->
            <TextBlock Text="TEMPERATURE" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Temperature, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="e.g. 36.8°C"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,15" FontSize="14"/>

            <!-- Pulse -->
            <TextBlock Text="PULSE RATE" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
            <TextBox Text="{Binding Pulse, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="e.g. 72 bpm"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,15" FontSize="14"/>

            <!-- SPO2 -->
            <TextBlock Text="OXYGEN SATURATION (SPO2)" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="0,0,0,6"/>
            <TextBox Text="{Binding SPO2, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="e.g. 98%"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,25" FontSize="14"/>

            <!-- Action Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="CANCEL" 
                        Style="{StaticResource DialogOutlinedButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="False"
                        Height="40" Margin="0,0,8,0"/>

                <Button Grid.Column="1" Content="SAVE VITALS"
                        Style="{StaticResource DialogActionButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="True"
                        Height="40" Margin="8,0,0,0"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
