<UserControl x:Class="HMS.Core.Views.NurseVitalsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="#F1F5F9">

    <UserControl.Resources>
        <!-- Consistent action button style matching Doctor portal -->
        <Style x:Key="VitalsActionButton" TargetType="Button">
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2563EB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Consistent outlined button style -->
        <Style x:Key="VitalsOutlinedButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="BorderThickness" Value="1.5"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#94A3B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,25">
            <StackPanel>
                <TextBlock Text="PATIENT VITALS MONITOR" Style="{DynamicResource MaterialDesignHeadline5TextBlock}"
                           FontWeight="Bold" Foreground="#1E293B"/>
                <TextBlock Text="Real-time monitoring of patient health metrics across all wards." 
                           Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" Opacity="0.6"/>
            </StackPanel>
            
            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                    Command="{Binding RefreshCommand}" Style="{StaticResource VitalsOutlinedButton}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="REFRESH DATA"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Search & Filter Bar -->
        <materialDesign:Card Grid.Row="1" Margin="0,0,0,20" UniformCornerRadius="10" materialDesign:ElevationAssist.Elevation="Dp1">
            <Border Padding="15,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <materialDesign:PackIcon Kind="Search" Foreground="#94A3B8" VerticalAlignment="Center" Margin="10,0" Width="20" Height="20"/>
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Search by patient name or room number..."
                             materialDesign:TextFieldAssist.DecorationVisibility="Collapsed"
                             BorderThickness="0" VerticalAlignment="Center" FontSize="14"/>
                </Grid>
            </Border>
        </materialDesign:Card>

        <!-- Vitals Grid -->
        <materialDesign:Card Grid.Row="2" UniformCornerRadius="15" materialDesign:ElevationAssist.Elevation="Dp1">
            <DataGrid ItemsSource="{Binding FilteredVitals}"
                      SelectedItem="{Binding SelectedPatient}"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      CanUserAddRows="False" SelectionMode="Single"
                      Background="Transparent" BorderThickness="0"
                      HeadersVisibility="Column" GridLinesVisibility="None">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource MaterialDesignDataGridColumnHeader}">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Height" Value="50"/>
                        <Setter Property="Padding" Value="15,0"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#475569"/>
                    </Style>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource MaterialDesignDataGridRow}">
                        <Setter Property="Height" Value="65"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <!-- Room & Patient -->
                    <DataGridTemplateColumn Header="PATIENT / ROOM" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="15,0">
                                    <Border Background="#F1F5F9" Padding="8,4" CornerRadius="6" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding RoomNumber}" FontWeight="Bold" Foreground="#475569" FontSize="11"/>
                                    </Border>
                                    <TextBlock Text="{Binding PatientName}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#1E293B"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- BP -->
                    <DataGridTemplateColumn Header="BLOOD PRESSURE" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Heart" Foreground="#EF4444" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding BP}" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Temp -->
                    <DataGridTemplateColumn Header="TEMP" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Temperature}" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Pulse -->
                    <DataGridTextColumn Header="PULSE" Binding="{Binding Pulse}" Width="*"/>
                    
                    <!-- SPO2 -->
                    <DataGridTemplateColumn Header="SPO2" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="#D1FAE5" Padding="10,4" CornerRadius="12" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SPO2}" FontWeight="Bold" Foreground="#059669" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Last Update -->
                    <DataGridTextColumn Header="LAST CHECK" Binding="{Binding LastUpdated}" Width="*" Foreground="#94A3B8"/>

                    <!-- Actions - passes the row item directly via CommandParameter -->
                    <DataGridTemplateColumn Header="ACTION" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="UPDATE" 
                                        Style="{StaticResource VitalsActionButton}"
                                        Command="{Binding DataContext.UpdateVitalsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </materialDesign:Card>
    </Grid>
</UserControl>
