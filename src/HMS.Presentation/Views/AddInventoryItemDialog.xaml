<UserControl x:Class="HMS.Core.Views.AddInventoryItemDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="500" MaxHeight="640">
    <Border Background="White" CornerRadius="15" Padding="30">
        <StackPanel>
            <TextBlock Text="ADD NEW INVENTORY ITEM" FontSize="20" FontWeight="ExtraBold" Foreground="#1E293B" Margin="0,0,0,25"/>

            <!-- Name -->
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="Item Name *"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,15"/>

            <!-- SKU -->
            <TextBox Text="{Binding SKU, UpdateSourceTrigger=PropertyChanged}"
                     materialDesign:HintAssist.Hint="SKU Code (optional)"
                     Style="{DynamicResource MaterialDesignOutlinedTextBox}"
                     Margin="0,0,0,15"/>

            <!-- Category (use Tag to capture selection) -->
            <ComboBox x:Name="CategoryCombo"
                      materialDesign:HintAssist.Hint="Category"
                      Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                      SelectedIndex="0"
                      SelectionChanged="CategoryCombo_SelectionChanged"
                      Margin="0,0,0,15">
                <ComboBoxItem Content="Medicine" Tag="Medicine"/>
                <ComboBoxItem Content="Medical Supply" Tag="Medical Supply"/>
                <ComboBoxItem Content="Equipment" Tag="Equipment"/>
                <ComboBoxItem Content="Consumable" Tag="Consumable"/>
            </ComboBox>

            <!-- Selling Price + Stock Qty -->
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <TextBox Text="{Binding SellingUnitPrice, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Selling Price (ETB)"
                         Style="{DynamicResource MaterialDesignOutlinedTextBox}"/>
                         
                <TextBox Grid.Column="2" Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}"
                         materialDesign:HintAssist.Hint="Stock Quantity"
                         Style="{DynamicResource MaterialDesignOutlinedTextBox}"/>
            </Grid>

            <!-- Unit Type -->
            <ComboBox x:Name="UnitTypeCombo"
                      materialDesign:HintAssist.Hint="Unit Type"
                      Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                      SelectedIndex="0"
                      SelectionChanged="UnitTypeCombo_SelectionChanged"
                      Margin="0,0,0,15">
                <ComboBoxItem Content="Pills"/>
                <ComboBoxItem Content="Tablets"/>
                <ComboBoxItem Content="Capsules"/>
                <ComboBoxItem Content="Bottles"/>
                <ComboBoxItem Content="Vials"/>
                <ComboBoxItem Content="Ampoules"/>
            </ComboBox>
            
            <!-- Expiry Date -->
            <DatePicker SelectedDate="{Binding ExpiryDate}"
                        materialDesign:HintAssist.Hint="Expiry Date"
                        Style="{DynamicResource MaterialDesignOutlinedDatePicker}"
                        Margin="0,0,0,25"/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button Content="CANCEL" 
                        Style="{DynamicResource MaterialDesignOutlinedButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="False"
                        Height="42" Margin="0,0,8,0"/>

                <Button Grid.Column="1" Content="SAVE ITEM"
                        Style="{DynamicResource MaterialDesignFlatMidPrimaryButton}"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        CommandParameter="True"
                        Background="#8B5CF6" Foreground="White" BorderThickness="0"
                        Height="42" Margin="8,0,0,0"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
