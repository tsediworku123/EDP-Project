<UserControl x:Class="HMS.Core.Views.AddAppointmentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="500" Padding="0">
    <Border Background="White" CornerRadius="15" Padding="35,30">
        <StackPanel>
            <TextBlock Text="NEW APPOINTMENT" Style="{DynamicResource MaterialDesignHeadline6TextBlock}" 
                       FontWeight="Bold" Margin="0,0,0,25" HorizontalAlignment="Center" Foreground="#1E293B"/>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Select Patient *" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding Patients}"
                          SelectedItem="{Binding SelectedPatient}"
                          Style="{DynamicResource MaterialDesignOutlinedComboBox}"
                          Padding="15" materialDesign:HintAssist.Hint="Search or select patient">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding FullName}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Phone, StringFormat=' ({0})'}" Foreground="#64748B" FontSize="11"/>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Date *" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <DatePicker SelectedDate="{Binding AppointmentDate}" 
                                Style="{DynamicResource MaterialDesignOutlinedDatePicker}" Padding="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10,0,0,0">
                    <TextBlock Text="Time *" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                    <materialDesign:TimePicker SelectedTime="{Binding AppointmentTime}" 
                                              Style="{DynamicResource MaterialDesignOutlinedTimePicker}" Padding="12"/>
                </StackPanel>
            </Grid>

            <StackPanel Margin="0,0,0,20">
                <TextBlock Text="Priority" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                <ComboBox ItemsSource="{Binding PriorityOptions}"
                          SelectedItem="{Binding Priority}"
                          Style="{DynamicResource MaterialDesignOutlinedComboBox}" Padding="12"/>
            </StackPanel>

            <StackPanel Margin="0,0,0,30">
                <TextBlock Text="Reason for Visit *" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,8"/>
                <TextBox Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" 
                         Style="{DynamicResource MaterialDesignOutlinedTextBox}" 
                         Height="80" TextWrapping="Wrap" AcceptsReturn="True" 
                         VerticalContentAlignment="Top" Padding="15"
                         materialDesign:HintAssist.Hint="e.g. Regular follow-up, Routine checkup"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="CANCEL" Command="{Binding CancelCommand}" 
                        Style="{DynamicResource MaterialDesignFlatButton}" Margin="0,0,15,0" Foreground="#64748B"/>
                <Button Content="SCHEDULE APPOINTMENT" Command="{Binding SaveCommand}" 
                        Style="{DynamicResource MaterialDesignFlatMidPrimaryButton}" 
                        Background="#10B981" BorderBrush="#10B981" Width="200" Height="42"
                        materialDesign:ButtonAssist.CornerRadius="8"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
